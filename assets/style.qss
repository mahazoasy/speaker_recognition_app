QWidget {
    background-color: #10151f;
    color: #e8e8e8;
    font-family: "Segoe UI", "Open Sans", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #10151f;
}

/* ---------- Barre supérieure / titre ---------- */
#HeaderBar {
    background-color: #1a2332;
    border-bottom: 2px solid #FF6A3D;
}
#HeaderTitle {
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
}
#HeaderSubtitle {
    color: #9aa4b2;
    font-size: 12px;
}

/* ---------- Onglets ---------- */
QTabWidget::pane {
    border: 1px solid #262e3d;
    border-radius: 8px;
    background-color: #161d2b;
    top: -1px;
}
QTabBar::tab {
    background-color: #1a2332;
    color: #9aa4b2;
    padding: 10px 22px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 600;
}
QTabBar::tab:selected {
    background-color: #FF6A3D;
    color: #10151f;
}
QTabBar::tab:hover:!selected {
    background-color: #263049;
}

/* ---------- Cartes / panneaux ---------- */
.Panel, QFrame#Panel {
    background-color: #161d2b;
    border: 1px solid #262e3d;
    border-radius: 10px;
}

/* ---------- Boutons ---------- */
QPushButton {
    background-color: #FF6A3D;
    color: #10151f;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 700;
}
QPushButton:hover {
    background-color: #ff7f59;
}
QPushButton:pressed {
    background-color: #e35a30;
}
QPushButton:disabled {
    background-color: #3a3f4b;
    color: #7a8291;
}

QPushButton#SecondaryButton {
    background-color: #263049;
    color: #e8e8e8;
}
QPushButton#SecondaryButton:hover {
    background-color: #2f3b58;
}

QPushButton#DangerButton {
    background-color: #E53E3E;
    color: #ffffff;
}
QPushButton#DangerButton:hover {
    background-color: #f04d4d;
}

/* ---------- Champs de saisie ---------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #0d121b;
    border: 1px solid #303a4e;
    border-radius: 6px;
    padding: 8px 10px;
    color: #e8e8e8;
    selection-background-color: #FF6A3D;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #FF6A3D;
}

/* ---------- Listes / tables ---------- */
QListWidget, QTableWidget {
    background-color: #0d121b;
    border: 1px solid #262e3d;
    border-radius: 8px;
    gridline-color: #262e3d;
}
QHeaderView::section {
    background-color: #1a2332;
    color: #9aa4b2;
    padding: 6px;
    border: none;
    font-weight: 600;
}
QTableWidget::item:selected, QListWidget::item:selected {
    background-color: #FF6A3D;
    color: #10151f;
}

/* ---------- Barres de progression ---------- */
QProgressBar {
    background-color: #0d121b;
    border: 1px solid #303a4e;
    border-radius: 6px;
    text-align: center;
    color: #e8e8e8;
    height: 18px;
}
QProgressBar::chunk {
    background-color: #FF6A3D;
    border-radius: 5px;
}

/* ---------- Labels de statut ---------- */
QLabel#StatusOK {
    color: #48BB78;
    font-weight: 700;
}
QLabel#StatusWarn {
    color: #F6E05E;
    font-weight: 700;
}
QLabel#StatusError {
    color: #E53E3E;
    font-weight: 700;
}

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: #10151f;
    width: 10px;
}
QScrollBar::handle:vertical {
    background: #3a3f4b;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #FF6A3D;
}
